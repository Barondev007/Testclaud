pipeline {
    agent any

    parameters {
        string(name: 'CREDENTIAL_ID', defaultValue: 'my-secret-credential', description: 'ID of the credential stored in Jenkins')
    }

    stages {
        stage('Show Credential') {
            steps {
                script {
                    // For username/password credentials
                    withCredentials([usernamePassword(
                        credentialsId: params.CREDENTIAL_ID,
                        usernameVariable: 'USERNAME',
                        passwordVariable: 'PASSWORD'
                    )]) {
                        // Jenkins masks credentials by default, use this trick to reveal them
                        echo "Username: ${USERNAME}"
                        echo "Password (masked by Jenkins): ${PASSWORD}"

                        // To actually show the password in logs (NOT recommended for production!)
                        // Option 1: Base64 encode (decode with: echo "value" | base64 -d)
                        sh "echo 'Password (base64):' && echo '${PASSWORD}' | base64"

                        // Option 2: Write to file
                        writeFile file: 'temp_secret.txt', text: PASSWORD
                        sh 'echo "Password from file:" && cat temp_secret.txt && rm temp_secret.txt'
                    }
                }
            }
        }

        stage('Alternative - Secret Text') {
            steps {
                script {
                    // For secret text credentials
                    withCredentials([string(
                        credentialsId: params.CREDENTIAL_ID,
                        variable: 'SECRET_VALUE'
                    )]) {
                        echo "Secret (masked): ${SECRET_VALUE}"

                        // To reveal it in logs
                        sh "echo 'Secret (base64):' && echo '${SECRET_VALUE}' | base64"

                        writeFile file: 'temp_secret.txt', text: SECRET_VALUE
                        sh 'echo "Secret from file:" && cat temp_secret.txt && rm temp_secret.txt'
                    }
                }
            }
        }
    }
}
