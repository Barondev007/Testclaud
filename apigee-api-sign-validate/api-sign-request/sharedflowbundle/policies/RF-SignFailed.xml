<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<RaiseFault async="false" continueOnError="false" enabled="true" name="RF-SignFailed">
  <DisplayName>RF-SignFailed</DisplayName>
  <FaultResponse>
    <Set>
      <StatusCode>502</StatusCode>
      <ReasonPhrase>Bad Gateway</ReasonPhrase>
      <Headers>
        <Header name="Content-Type">application/json</Header>
      </Headers>
      <Payload contentType="application/json">{"error":"SIGN_REQUEST_FAILED","message":"Signature Service failed to return a signature"}</Payload>
    </Set>
  </FaultResponse>
  <AssignVariable>
    <Name>sign.error</Name>
    <Value>SIGN_REQUEST_FAILED</Value>
  </AssignVariable>
  <AssignVariable>
    <Name>sign.errorMessage</Name>
    <Value>Signature Service failed to return a signature</Value>
  </AssignVariable>
</RaiseFault>
