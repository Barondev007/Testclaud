<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<ProxyEndpoint name="default">
    <PreFlow name="PreFlow">
        <Request>
            <!-- Raise fault if routing header is missing -->
            <Step>
                <Name>RF-MissingHeader</Name>
                <Condition>request.header.X-Route-To = null</Condition>
            </Step>
            <!-- Lookup the target proxy basepath from KVM using the header value -->
            <Step>
                <Name>KVM-GetTargetProxy</Name>
            </Step>
            <!-- Raise fault if no mapping found in KVM -->
            <Step>
                <Name>RF-ProxyNotFound</Name>
                <Condition>private.targetProxyBasePath = null</Condition>
            </Step>
            <!-- Build the local target URL -->
            <Step>
                <Name>AM-SetTargetRoute</Name>
            </Step>
        </Request>
        <Response/>
    </PreFlow>
    <Flows/>
    <PostFlow name="PostFlow">
        <Request/>
        <Response/>
    </PostFlow>
    <HTTPProxyConnection>
        <BasePath>/router</BasePath>
    </HTTPProxyConnection>
    <RouteRule name="default">
        <TargetEndpoint>default</TargetEndpoint>
    </RouteRule>
</ProxyEndpoint>
