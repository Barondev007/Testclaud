<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<RaiseFault name="RF-MissingHeader">
    <DisplayName>RF - Missing Header</DisplayName>
    <FaultResponse>
        <Set>
            <StatusCode>400</StatusCode>
            <ReasonPhrase>Bad Request</ReasonPhrase>
            <Payload contentType="application/json">{"error":"Missing required header X-Route-To"}</Payload>
        </Set>
    </FaultResponse>
    <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
</RaiseFault>
