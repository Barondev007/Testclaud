<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<AssignMessage name="AM-SetTargetRoute">
    <DisplayName>AM - Set Target Route</DisplayName>
    <AssignVariable>
        <Name>target.url</Name>
        <Template>https://127.0.0.1{private.targetProxyBasePath}{proxy.pathsuffix}?{request.querystring}</Template>
    </AssignVariable>
    <IgnoreUnresolvedVariables>false</IgnoreUnresolvedVariables>
    <AssignTo createNew="false" transport="http" type="request"/>
</AssignMessage>
