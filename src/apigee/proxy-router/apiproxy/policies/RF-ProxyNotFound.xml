<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<RaiseFault name="RF-ProxyNotFound">
    <DisplayName>RF - Proxy Not Found</DisplayName>
    <FaultResponse>
        <Set>
            <StatusCode>404</StatusCode>
            <ReasonPhrase>Not Found</ReasonPhrase>
            <Payload contentType="application/json">{"error":"No backend proxy configured for route '{request.header.X-Route-To}'"}</Payload>
        </Set>
    </FaultResponse>
    <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
</RaiseFault>
