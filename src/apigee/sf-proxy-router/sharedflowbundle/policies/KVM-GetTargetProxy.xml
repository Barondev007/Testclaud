<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<KeyValueMapOperations name="KVM-GetTargetProxy" mapIdentifier="{flow.kvm.name}">
    <DisplayName>KVM - Get Target Proxy</DisplayName>
    <Scope>environment</Scope>
    <ExpiryTimeInSecs>300</ExpiryTimeInSecs>
    <Get assignTo="private.targetProxy">
        <Key>
            <Parameter ref="flow.routing.key"/>
        </Key>
    </Get>
</KeyValueMapOperations>
