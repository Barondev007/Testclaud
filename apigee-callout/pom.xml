<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.example</groupId>
    <artifactId>openapi-validator-apigee-callout</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>OpenAPI Validator Apigee Java Callout</name>
    <description>Apigee Java Callout for OpenAPI request validation - minimal JAR with separate dependency JARs</description>

    <properties>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- swagger-request-validator version is now specified directly in dependency -->
        <!-- Directory where dependency JARs will be copied for Apigee upload -->
        <apigee.resources.dir>${project.build.directory}/apigee-resources</apigee.resources.dir>
    </properties>

    <repositories>
        <repository>
            <id>apigee-maven-repo</id>
            <url>https://raw.githubusercontent.com/apigee/api-platform-samples/master/doc-samples/java-cookbook/lib</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- ================================================================== -->
        <!-- APIGEE 4.52 PROVIDED DEPENDENCIES - NOT BUNDLED                   -->
        <!-- These are available in Apigee Edge runtime                         -->
        <!-- ================================================================== -->

        <!-- Apigee Java Callout API -->
        <dependency>
            <groupId>com.apigee.edge</groupId>
            <artifactId>expressions</artifactId>
            <version>1.0.0</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.apigee.edge</groupId>
            <artifactId>message-flow</artifactId>
            <version>1.0.0</version>
            <scope>provided</scope>
        </dependency>

        <!-- Jackson 2.12.x - PROVIDED BY APIGEE 4.52 -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-core</artifactId>
            <version>2.12.7</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.12.7</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
            <version>2.12.7</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-yaml</artifactId>
            <version>2.12.7</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
            <version>2.12.7</version>
            <scope>provided</scope>
        </dependency>

        <!-- Guava 30.x - PROVIDED BY APIGEE 4.52 -->
        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
            <version>30.1-jre</version>
            <scope>provided</scope>
        </dependency>

        <!-- SLF4J 1.7.x - PROVIDED BY APIGEE 4.52 -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>1.7.36</version>
            <scope>provided</scope>
        </dependency>

        <!-- Apache Commons - PROVIDED BY APIGEE 4.52 -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
            <version>3.12.0</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>commons-io</groupId>
            <artifactId>commons-io</artifactId>
            <version>2.11.0</version>
            <scope>provided</scope>
        </dependency>

        <!-- Joda-Time - PROVIDED BY APIGEE 4.52 -->
        <dependency>
            <groupId>joda-time</groupId>
            <artifactId>joda-time</artifactId>
            <version>2.10.14</version>
            <scope>provided</scope>
        </dependency>

        <!-- Apache HttpClient - PROVIDED BY APIGEE -->
        <dependency>
            <groupId>org.apache.httpcomponents</groupId>
            <artifactId>httpclient</artifactId>
            <version>4.5.13</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.httpcomponents</groupId>
            <artifactId>httpcore</artifactId>
            <version>4.4.14</version>
            <scope>provided</scope>
        </dependency>

        <!-- Apache Commons Codec - PROVIDED BY APIGEE -->
        <dependency>
            <groupId>commons-codec</groupId>
            <artifactId>commons-codec</artifactId>
            <version>1.15</version>
            <scope>provided</scope>
        </dependency>

        <!-- Apache Commons Collections - PROVIDED BY APIGEE -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-collections4</artifactId>
            <version>4.4</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>commons-collections</groupId>
            <artifactId>commons-collections</artifactId>
            <version>3.2.2</version>
            <scope>provided</scope>
        </dependency>

        <!-- Javax Servlet API - PROVIDED BY APIGEE -->
        <dependency>
            <groupId>javax.servlet</groupId>
            <artifactId>javax.servlet-api</artifactId>
            <version>4.0.1</version>
            <scope>provided</scope>
        </dependency>

        <!-- SnakeYAML - May be PROVIDED BY APIGEE (check your version) -->
        <!-- If Apigee provides it, uncomment this and remove from runtime deps
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
            <version>1.30</version>
            <scope>provided</scope>
        </dependency>
        -->

        <!-- Gson - PROVIDED BY APIGEE -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.9.0</version>
            <scope>provided</scope>
        </dependency>

        <!-- NOTE: Bouncy Castle is NOT needed for OpenAPI validation -->
        <!-- It's excluded from swagger-request-validator dependencies -->

        <!-- ================================================================== -->
        <!-- DEPENDENCIES TO UPLOAD AS APIGEE PROXY RESOURCES                  -->
        <!-- These are NOT available in Apigee Edge 4.52 runtime               -->
        <!-- They will be copied to target/apigee-resources for upload         -->
        <!-- ================================================================== -->

        <!-- Atlassian Swagger Request Validator Core - REQUIRED -->
        <!-- Using older, smaller version 2.19.x instead of 2.30.0 -->
        <dependency>
            <groupId>com.atlassian.oai</groupId>
            <artifactId>swagger-request-validator-core</artifactId>
            <version>2.19.4</version>
            <exclusions>
                <!-- Exclude Apigee-provided dependencies -->
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>ch.qos.logback</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.fasterxml.jackson.core</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.fasterxml.jackson.dataformat</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.fasterxml.jackson.datatype</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.google.guava</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.google.code.findbugs</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.google.errorprone</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.google.j2objc</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.apache.commons</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>commons-io</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>commons-logging</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>joda-time</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>javax.validation</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>javax.mail</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.sun.mail</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>junit</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.hamcrest</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.springframework</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.github.tomakehurst</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.checkerframework</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
                <!-- Additional exclusions to reduce size -->
                <exclusion>
                    <groupId>com.damnhandy</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.mozilla</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.ethlo.time</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
                <!-- More Apigee-provided libraries -->
                <exclusion>
                    <groupId>org.apache.httpcomponents</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>commons-codec</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>commons-collections</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.bouncycastle</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.google.code.gson</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>javax.servlet</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
                <!-- Annotation libraries not needed at runtime -->
                <exclusion>
                    <groupId>javax.annotation</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.google.android</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- SnakeYAML - NOT provided by Apigee, REQUIRED for YAML parsing -->
        <!-- Using older smaller version -->
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
            <version>1.33</version>
        </dependency>

        <!-- NOTE: swagger-parser is NOT explicitly included because it's already
             a transitive dependency of swagger-request-validator-core.
             This avoids duplicate classes and reduces JAR size. -->

        <!-- Test dependencies -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>${maven.compiler.source}</source>
                    <target>${maven.compiler.target}</target>
                </configuration>
            </plugin>

            <!-- Create a minimal JAR with only the callout code (no dependencies) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>com.example.apigee.OpenApiValidatorCallout</mainClass>
                            <addClasspath>true</addClasspath>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>

            <!-- Copy runtime dependencies (not provided by Apigee) to apigee-resources folder -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <id>copy-apigee-resources</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${apigee.resources.dir}</outputDirectory>
                            <!-- Only include runtime dependencies (not provided, not test) -->
                            <includeScope>runtime</includeScope>
                            <!-- Exclude Apigee-provided dependencies -->
                            <excludeGroupIds>
                                com.apigee.edge,
                                com.fasterxml.jackson.core,
                                com.fasterxml.jackson.dataformat,
                                com.fasterxml.jackson.datatype,
                                com.google.guava,
                                com.google.code.findbugs,
                                com.google.code.gson,
                                com.google.errorprone,
                                com.google.j2objc,
                                com.google.android,
                                org.slf4j,
                                ch.qos.logback,
                                org.apache.commons,
                                org.apache.httpcomponents,
                                commons-io,
                                commons-logging,
                                commons-codec,
                                commons-collections,
                                joda-time,
                                javax.validation,
                                javax.mail,
                                javax.servlet,
                                javax.annotation,
                                com.sun.mail,
                                org.checkerframework,
                                org.bouncycastle,
                                org.codehaus.mojo
                            </excludeGroupIds>
                            <overWriteReleases>false</overWriteReleases>
                            <overWriteSnapshots>true</overWriteSnapshots>
                        </configuration>
                    </execution>
                    <!-- Also copy the main JAR to apigee-resources -->
                    <execution>
                        <id>copy-main-jar</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy</goal>
                        </goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>${project.groupId}</groupId>
                                    <artifactId>${project.artifactId}</artifactId>
                                    <version>${project.version}</version>
                                    <type>jar</type>
                                    <overWrite>true</overWrite>
                                    <outputDirectory>${apigee.resources.dir}</outputDirectory>
                                </artifactItem>
                            </artifactItems>
                        </configuration>
                    </execution>
                    <!-- Generate a list of dependencies for documentation -->
                    <execution>
                        <id>list-dependencies</id>
                        <phase>package</phase>
                        <goals>
                            <goal>list</goal>
                        </goals>
                        <configuration>
                            <outputFile>${apigee.resources.dir}/DEPENDENCY_LIST.txt</outputFile>
                            <includeScope>runtime</includeScope>
                            <excludeGroupIds>
                                com.apigee.edge,
                                com.fasterxml.jackson.core,
                                com.fasterxml.jackson.dataformat,
                                com.fasterxml.jackson.datatype,
                                com.google.guava,
                                com.google.code.findbugs,
                                com.google.code.gson,
                                com.google.errorprone,
                                com.google.j2objc,
                                com.google.android,
                                org.slf4j,
                                ch.qos.logback,
                                org.apache.commons,
                                org.apache.httpcomponents,
                                commons-io,
                                commons-logging,
                                commons-codec,
                                commons-collections,
                                joda-time,
                                javax.validation,
                                javax.mail,
                                javax.servlet,
                                javax.annotation,
                                com.sun.mail,
                                org.checkerframework,
                                org.bouncycastle,
                                org.codehaus.mojo
                            </excludeGroupIds>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Generate a README for the apigee-resources folder -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>generate-readme</id>
                        <phase>package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <echo file="${apigee.resources.dir}/README.txt">
==========================================================================
APIGEE PROXY RESOURCES - OpenAPI Validator Java Callout
==========================================================================

This folder contains all JAR files needed for the OpenAPI Validator
Java Callout that are NOT provided by Apigee Edge 4.52 runtime.

DEPLOYMENT INSTRUCTIONS:
------------------------
1. Upload ALL .jar files from this folder to your Apigee proxy:
   - Go to Apigee Edge UI > Develop > API Proxies > [Your Proxy]
   - Click "Develop" tab
   - Under "Resources", click "+" and select "Java"
   - Upload each JAR file from this folder

2. Or use the Apigee Management API:
   curl -X POST \
     "https://api.enterprise.apigee.com/v1/organizations/{org}/apis/{api}/revisions/{rev}/resources?type=java&amp;name={filename}.jar" \
     -H "Authorization: Bearer $TOKEN" \
     -H "Content-Type: application/octet-stream" \
     --data-binary @{filename}.jar

3. Or place in apiproxy/resources/java/ folder for offline deployment

APIGEE 4.52 PROVIDED DEPENDENCIES (NOT INCLUDED):
-------------------------------------------------
- Jackson 2.12.x (jackson-core, jackson-databind, jackson-annotations)
- Jackson dataformat YAML 2.12.x
- Guava 30.x
- SLF4J 1.7.x
- Apache Commons (Lang3, IO, Codec, Collections)
- Apache HttpClient/HttpCore 4.x
- Joda-Time 2.x
- Gson
- Servlet API

These dependencies are available in the Apigee Edge runtime and should
NOT be uploaded to avoid version conflicts.

==========================================================================
                                </echo>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!-- Profile for creating a shaded uber-JAR with aggressive minimization -->
    <profiles>
        <profile>
            <id>uber-jar</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-shade-plugin</artifactId>
                        <version>3.5.1</version>
                        <executions>
                            <execution>
                                <phase>package</phase>
                                <goals>
                                    <goal>shade</goal>
                                </goals>
                                <configuration>
                                    <createDependencyReducedPom>false</createDependencyReducedPom>
                                    <minimizeJar>true</minimizeJar>
                                    <shadedArtifactAttached>true</shadedArtifactAttached>
                                    <shadedClassifierName>uber</shadedClassifierName>
                                    <filters>
                                        <filter>
                                            <artifact>*:*</artifact>
                                            <excludes>
                                                <!-- Signature files -->
                                                <exclude>META-INF/*.SF</exclude>
                                                <exclude>META-INF/*.DSA</exclude>
                                                <exclude>META-INF/*.RSA</exclude>
                                                <!-- Legal files -->
                                                <exclude>META-INF/NOTICE*</exclude>
                                                <exclude>META-INF/LICENSE*</exclude>
                                                <exclude>META-INF/DEPENDENCIES</exclude>
                                                <exclude>META-INF/MANIFEST.MF</exclude>
                                                <!-- Build metadata -->
                                                <exclude>META-INF/maven/**</exclude>
                                                <exclude>META-INF/versions/**</exclude>
                                                <exclude>META-INF/native-image/**</exclude>
                                                <exclude>META-INF/proguard/**</exclude>
                                                <!-- Module info (Java 9+) -->
                                                <exclude>module-info.class</exclude>
                                                <!-- Android files -->
                                                <exclude>META-INF/*.kotlin_module</exclude>
                                                <!-- Unused resource files -->
                                                <exclude>**/*.html</exclude>
                                                <exclude>**/*.txt</exclude>
                                                <exclude>**/*.md</exclude>
                                                <exclude>**/pom.xml</exclude>
                                                <exclude>**/pom.properties</exclude>
                                            </excludes>
                                        </filter>
                                        <!-- Keep only used classes from swagger-request-validator -->
                                        <filter>
                                            <artifact>com.atlassian.oai:swagger-request-validator-core</artifact>
                                            <includes>
                                                <include>com/atlassian/oai/validator/**</include>
                                            </includes>
                                        </filter>
                                    </filters>
                                    <relocations>
                                        <relocation>
                                            <pattern>org.yaml.snakeyaml</pattern>
                                            <shadedPattern>shaded.org.yaml.snakeyaml</shadedPattern>
                                        </relocation>
                                        <relocation>
                                            <pattern>com.atlassian.oai</pattern>
                                            <shadedPattern>shaded.com.atlassian.oai</shadedPattern>
                                        </relocation>
                                        <relocation>
                                            <pattern>io.swagger</pattern>
                                            <shadedPattern>shaded.io.swagger</shadedPattern>
                                        </relocation>
                                    </relocations>
                                    <transformers>
                                        <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                            <mainClass>com.example.apigee.OpenApiValidatorCallout</mainClass>
                                        </transformer>
                                        <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                    </transformers>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Alternative: Use ProGuard for maximum compression (can reduce to ~3-5MB) -->
        <profile>
            <id>proguard</id>
            <build>
                <plugins>
                    <!-- First shade to create uber jar -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-shade-plugin</artifactId>
                        <version>3.5.1</version>
                        <executions>
                            <execution>
                                <phase>package</phase>
                                <goals>
                                    <goal>shade</goal>
                                </goals>
                                <configuration>
                                    <createDependencyReducedPom>false</createDependencyReducedPom>
                                    <minimizeJar>false</minimizeJar>
                                    <shadedArtifactAttached>true</shadedArtifactAttached>
                                    <shadedClassifierName>pre-proguard</shadedClassifierName>
                                    <filters>
                                        <filter>
                                            <artifact>*:*</artifact>
                                            <excludes>
                                                <exclude>META-INF/*.SF</exclude>
                                                <exclude>META-INF/*.DSA</exclude>
                                                <exclude>META-INF/*.RSA</exclude>
                                                <exclude>META-INF/NOTICE*</exclude>
                                                <exclude>META-INF/LICENSE*</exclude>
                                                <exclude>META-INF/DEPENDENCIES</exclude>
                                                <exclude>META-INF/maven/**</exclude>
                                                <exclude>META-INF/versions/**</exclude>
                                                <exclude>module-info.class</exclude>
                                            </excludes>
                                        </filter>
                                    </filters>
                                    <transformers>
                                        <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                    </transformers>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <!-- Then apply ProGuard -->
                    <plugin>
                        <groupId>com.github.wvengen</groupId>
                        <artifactId>proguard-maven-plugin</artifactId>
                        <version>2.6.1</version>
                        <executions>
                            <execution>
                                <phase>package</phase>
                                <goals>
                                    <goal>proguard</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <injar>${project.build.finalName}-pre-proguard.jar</injar>
                            <outjar>${project.build.finalName}-optimized.jar</outjar>
                            <obfuscate>false</obfuscate>
                            <options>
                                <option>-dontoptimize</option>
                                <option>-dontwarn **</option>
                                <option>-keep public class com.example.apigee.OpenApiValidatorCallout { *; }</option>
                                <option>-keep class com.apigee.** { *; }</option>
                                <option>-keepattributes Signature,*Annotation*</option>
                            </options>
                            <libs>
                                <lib>${java.home}/lib/rt.jar</lib>
                            </libs>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
