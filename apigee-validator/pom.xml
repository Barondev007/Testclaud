<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>be.bnppf</groupId>
    <!-- Simple name without hyphens for Edge compatibility -->
    <artifactId>openapivalidator</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>BNPPF OpenAPI Validator for Apigee Edge</name>
    <description>OpenAPI Request/Response Validator optimized for Apigee Edge</description>

    <properties>
        <!-- Java 8 for Apigee compatibility -->
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Use older version for better compatibility -->
        <swagger-request-validator.version>2.19.4</swagger-request-validator.version>
    </properties>

    <dependencies>
        <!-- Atlassian Swagger Request Validator Core -->
        <dependency>
            <groupId>com.atlassian.oai</groupId>
            <artifactId>swagger-request-validator-core</artifactId>
            <version>${swagger-request-validator.version}</version>
            <exclusions>
                <!-- ========================================= -->
                <!-- APIGEE-PROVIDED LIBRARIES - EXCLUDE ALL  -->
                <!-- ========================================= -->

                <!-- SLF4J - Apigee has its own logging -->
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>ch.qos.logback</groupId>
                    <artifactId>*</artifactId>
                </exclusion>

                <!-- Guava - Apigee bundles its own version -->
                <exclusion>
                    <groupId>com.google.guava</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.google.code.findbugs</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.google.code.gson</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.google.errorprone</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.google.j2objc</groupId>
                    <artifactId>*</artifactId>
                </exclusion>

                <!-- Jackson - Apigee provides 2.12.x -->
                <exclusion>
                    <groupId>com.fasterxml.jackson.core</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.fasterxml.jackson.dataformat</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.fasterxml.jackson.datatype</groupId>
                    <artifactId>*</artifactId>
                </exclusion>

                <!-- Apache Commons - Apigee provides these -->
                <exclusion>
                    <groupId>org.apache.commons</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>commons-io</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>commons-logging</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>commons-codec</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>commons-collections</groupId>
                    <artifactId>*</artifactId>
                </exclusion>

                <!-- Apache HttpClient - Apigee provides -->
                <exclusion>
                    <groupId>org.apache.httpcomponents</groupId>
                    <artifactId>*</artifactId>
                </exclusion>

                <!-- Joda-Time - Apigee provides -->
                <exclusion>
                    <groupId>joda-time</groupId>
                    <artifactId>*</artifactId>
                </exclusion>

                <!-- Javax APIs - Apigee provides -->
                <exclusion>
                    <groupId>javax.annotation</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>javax.validation</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>javax.mail</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>javax.servlet</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.sun.mail</groupId>
                    <artifactId>*</artifactId>
                </exclusion>

                <!-- Other exclusions -->
                <exclusion>
                    <groupId>org.checkerframework</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.bouncycastle</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.damnhandy</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.ethlo.time</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- SLF4J - PROVIDED BY APIGEE (compile scope for IDE, excluded from shaded JAR) -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>1.7.32</version>
            <scope>provided</scope>
        </dependency>

        <!-- Test dependencies -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.1</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>${maven.compiler.source}</source>
                    <target>${maven.compiler.target}</target>
                </configuration>
            </plugin>

            <!-- Shade plugin optimized for Apigee -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <!-- Enable minimizeJar for smaller JAR size -->
                            <minimizeJar>true</minimizeJar>
                            <!-- Minimal transformers for Edge compatibility -->
                            <transformers>
                                <!-- Simple manifest without mainClass (library JAR) -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer"/>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <!-- Security signatures - CRITICAL for Edge -->
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>META-INF/*.EC</exclude>
                                        <exclude>META-INF/MANIFEST.MF</exclude>
                                        <!-- Legal files -->
                                        <exclude>META-INF/LICENSE*</exclude>
                                        <exclude>META-INF/NOTICE*</exclude>
                                        <exclude>META-INF/DEPENDENCIES</exclude>
                                        <exclude>META-INF/AL2.0</exclude>
                                        <exclude>META-INF/LGPL2.1</exclude>
                                        <!-- Maven/build files -->
                                        <exclude>META-INF/maven/**</exclude>
                                        <!-- Java 9+ Multi-Release JARs - Edge doesn't support -->
                                        <exclude>META-INF/versions/**</exclude>
                                        <!-- Module info (Java 9+) -->
                                        <exclude>module-info.class</exclude>
                                        <exclude>**/module-info.class</exclude>
                                        <!-- Exclude test classes -->
                                        <exclude>**/test/**</exclude>
                                        <!-- Annotation processors -->
                                        <exclude>META-INF/services/javax.annotation.processing.Processor</exclude>
                                        <!-- Native libraries - Edge won't use them -->
                                        <exclude>**/*.so</exclude>
                                        <exclude>**/*.dll</exclude>
                                        <exclude>**/*.dylib</exclude>
                                        <!-- Proguard/R8 files -->
                                        <exclude>META-INF/proguard/**</exclude>
                                        <!-- Kotlin metadata -->
                                        <exclude>META-INF/*.kotlin_module</exclude>
                                        <!-- Spring files (not needed) -->
                                        <exclude>META-INF/spring.*</exclude>
                                        <!-- GraalVM native-image config -->
                                        <exclude>META-INF/native-image/**</exclude>
                                        <!-- Text files -->
                                        <exclude>**/*.html</exclude>
                                        <exclude>**/*.txt</exclude>
                                        <exclude>**/*.md</exclude>
                                        <exclude>**/pom.xml</exclude>
                                        <exclude>**/pom.properties</exclude>
                                        <!-- OpenAPI spec examples (if any) -->
                                        <exclude>openapi/**</exclude>
                                    </excludes>
                                </filter>
                                <!-- Keep all validator classes needed for runtime -->
                                <filter>
                                    <artifact>be.bnppf:openapivalidator</artifact>
                                    <includes>
                                        <include>**</include>
                                    </includes>
                                </filter>
                            </filters>
                            <relocations>
                                <!--
                                    APIGEE-SPECIFIC RELOCATIONS
                                    ALL dependencies must be relocated to avoid conflicts with Apigee runtime
                                -->

                                <!-- ===== GOOGLE PACKAGES ===== -->
                                <!-- Relocate ALL com.google packages -->
                                <relocation>
                                    <pattern>com.google</pattern>
                                    <shadedPattern>apigee.shaded.com.google</shadedPattern>
                                </relocation>

                                <!-- ===== JAVAX PACKAGES ===== -->
                                <!-- Relocate javax.validation -->
                                <relocation>
                                    <pattern>javax.validation</pattern>
                                    <shadedPattern>apigee.shaded.javax.validation</shadedPattern>
                                </relocation>
                                <!-- Relocate javax.inject -->
                                <relocation>
                                    <pattern>javax.inject</pattern>
                                    <shadedPattern>apigee.shaded.javax.inject</shadedPattern>
                                </relocation>
                                <!-- Relocate javax.mail -->
                                <relocation>
                                    <pattern>javax.mail</pattern>
                                    <shadedPattern>apigee.shaded.javax.mail</shadedPattern>
                                </relocation>

                                <!-- ===== APACHE PACKAGES ===== -->
                                <!-- Relocate ALL org.apache packages -->
                                <relocation>
                                    <pattern>org.apache</pattern>
                                    <shadedPattern>apigee.shaded.org.apache</shadedPattern>
                                </relocation>

                                <!-- ===== CORE DEPENDENCIES ===== -->
                                <!-- Relocate Atlassian OAI Validator -->
                                <relocation>
                                    <pattern>com.atlassian.oai</pattern>
                                    <shadedPattern>apigee.shaded.com.atlassian.oai</shadedPattern>
                                </relocation>

                                <!-- Relocate Jackson - CRITICAL: Apigee has older Jackson -->
                                <relocation>
                                    <pattern>com.fasterxml.jackson</pattern>
                                    <shadedPattern>apigee.shaded.com.fasterxml.jackson</shadedPattern>
                                </relocation>

                                <!-- Relocate SnakeYAML -->
                                <relocation>
                                    <pattern>org.yaml.snakeyaml</pattern>
                                    <shadedPattern>apigee.shaded.org.yaml.snakeyaml</shadedPattern>
                                </relocation>

                                <!-- Relocate SLF4J -->
                                <relocation>
                                    <pattern>org.slf4j</pattern>
                                    <shadedPattern>apigee.shaded.org.slf4j</shadedPattern>
                                </relocation>

                                <!-- Relocate Swagger Parser -->
                                <relocation>
                                    <pattern>io.swagger</pattern>
                                    <shadedPattern>apigee.shaded.io.swagger</shadedPattern>
                                </relocation>

                                <!-- ===== JSON SCHEMA VALIDATORS ===== -->
                                <!-- Relocate JSON Schema Validator (networknt) -->
                                <relocation>
                                    <pattern>com.networknt</pattern>
                                    <shadedPattern>apigee.shaded.com.networknt</shadedPattern>
                                </relocation>

                                <!-- Relocate FGE JSON Schema -->
                                <relocation>
                                    <pattern>com.github.fge</pattern>
                                    <shadedPattern>apigee.shaded.com.github.fge</shadedPattern>
                                </relocation>

                                <!-- Relocate Ethlo time -->
                                <relocation>
                                    <pattern>com.ethlo</pattern>
                                    <shadedPattern>apigee.shaded.com.ethlo</shadedPattern>
                                </relocation>

                                <!-- ===== OTHER DEPENDENCIES ===== -->
                                <!-- Relocate Joda Time -->
                                <relocation>
                                    <pattern>org.joda</pattern>
                                    <shadedPattern>apigee.shaded.org.joda</shadedPattern>
                                </relocation>

                                <!-- Relocate Mozilla Rhino -->
                                <relocation>
                                    <pattern>org.mozilla</pattern>
                                    <shadedPattern>apigee.shaded.org.mozilla</shadedPattern>
                                </relocation>

                                <!-- Relocate JONI (regex library) -->
                                <relocation>
                                    <pattern>org.joni</pattern>
                                    <shadedPattern>apigee.shaded.org.joni</shadedPattern>
                                </relocation>

                                <!-- Relocate JCodings -->
                                <relocation>
                                    <pattern>org.jcodings</pattern>
                                    <shadedPattern>apigee.shaded.org.jcodings</shadedPattern>
                                </relocation>

                                <!-- Relocate Checker Framework -->
                                <relocation>
                                    <pattern>org.checkerframework</pattern>
                                    <shadedPattern>apigee.shaded.org.checkerframework</shadedPattern>
                                </relocation>
                            </relocations>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.2</version>
            </plugin>
        </plugins>
    </build>
</project>
